# Copy this file to .env and fill in the values. Never commit .env.
# Only EXPO_PUBLIC_ variables are bundled into the app (visible in plain text): never put a secret there.

# Clerk (authentication). The webhook secret (whsec_...) comes from Dashboard > Webhooks > your endpoint.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Neon (Postgres). In development: connection string of the dev branch.
DATABASE_URL=

# Anthropic (AI). The model id lives in src/server/config.ts (Haiku 4.5); ANTHROPIC_MODEL overrides it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Quotas, read by src/server/config.ts (defaults when empty: 3 trips a month, 5 adjustments a trip).
# High values in development; production values come with the EAS environment.
QUOTA_TRIPS_PER_MONTH=1000
QUOTA_ADJUSTMENTS_PER_TRIP=100

# Unsplash (default cover photos)
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=

# Inngest (background jobs) — 1 = local dev server
INNGEST_DEV=1
# Production keys (Inngest Cloud): leave empty in development, the Dev Server does not need them.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ImageKit (user-uploaded cover photos). The URL endpoint is https://ik.imagekit.io/<your_imagekit_id> (Dashboard > URL endpoints):
# the server builds the cover URLs from it. The private key only signs the uploads, server-side.
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_URL_ENDPOINT=

# Sentry (source maps upload)
SENTRY_AUTH_TOKEN=
